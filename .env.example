# =================================================================
# RESQFLY ENVIRONMENT CONFIGURATION
# =================================================================

# Server Configuration
PORT=8000
HOST=127.0.0.1
DEBUG=true

# Operational Mode
# Set to 'aws_connected' to enable real cloud services, or leave empty for Local Simulation Mode
RESQFLY_MODE=local_simulation

# AWS Cloud Credentials & Region (Optional - Only needed for AWS-Connected Mode)
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# AWS IoT Core
AWS_IOT_ENDPOINT=
AWS_IOT_CLIENT_ID=resqfly-ground-station

# Amazon DynamoDB Table Prefix
AWS_DYNAMODB_PREFIX=resqfly

# Amazon S3 Evidence Bucket
AWS_S3_EVIDENCE_BUCKET=resqfly-evidence-storage

# Amazon Cognito
AWS_COGNITO_USER_POOL_ID=
AWS_COGNITO_CLIENT_ID=

# Amazon Bedrock (Optional generative situational reports)
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
